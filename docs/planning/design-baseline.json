  "acceptance_checks": [
    {
      "id": "A01",
      "name": "范围被固定且不能静默缩减",
      "method": "输入完整产品/选择能力/缺运行条件三类任务，检查范围、排除、阻塞及授权变更。",
      "pass_criterion": "范围变更均可追溯；输入不足不会制造最终完成。",
      "kind": "混合",
      "suite": "B-BLOCKED",
      "status": "not_run",
      "evidence": []
    },
    {
      "id": "A02",
      "name": "产品面发现跨越代码目录",
      "method": "对多入口和混合界面的样例用独立清单检查遗漏。",
      "pass_criterion": "产品能力不是按目录照抄，遗漏转义务或问题。",
      "kind": "语义与清单对照",
      "suite": "B-MIXED",
      "status": "not_run",
      "evidence": []
    },
    {
      "id": "A03",
      "name": "完整工作流恢复",
      "method": "使用含默认、权限、取消、恢复和配置优先级的参考样例核对设计。",
      "pass_criterion": "范围内重要分支有确定语义与验收；材料冲突不被掩盖。",
      "kind": "语义与参考观察",
      "suite": "B-CLI",
      "status": "not_run",
      "evidence": []
    },
    {
      "id": "A04",
      "name": "体验不止截图和令牌",
      "method": "对含加载、空、错误、部分成功、键盘、焦点和响应式的 UI 样例走查。",
      "pass_criterion": "视图、状态与系统行为相互对应，缺少数值或交互时不闭合。",
      "kind": "语义与运行观察",
      "suite": "B-WEB",
      "status": "not_run",
      "evidence": []
    },
    {
      "id": "A05",
      "name": "设计完整但不复制原架构",
      "method": "检查职责、所有权、协作与实现自由；采用不同内部方案评审。",
      "pass_criterion": "必要逻辑设计存在，原私有结构不被无必要强制继承。",
      "kind": "设计审阅",
      "suite": "B-SERVICE",
      "status": "not_run",
      "evidence": []
    },
    {
      "id": "A06",
      "name": "接口数据与运行语义一致",
      "method": "对 Schema、协议、状态、并发、错误和副作用构造正反例。",
      "pass_criterion": "格式可消费，公开契约与状态/恢复语义一致。",
      "kind": "结构与语义",
      "suite": "B-SERVICE",
      "status": "not_run",
      "evidence": []
    },
    {
      "id": "A07",
      "name": "选择能力具备传递依赖",
      "method": "只选一个依赖权限、共享配置和数据状态的能力。",
      "pass_criterion": "依赖被纳入、以完整契约外置或经批准改造，没有悬空责任。",
